# Copia este archivo a  .env  (está en .gitignore; NUNCA se sube al repo ni se pega en un chat)
#
# Dónde sacarlas: Supabase → tu proyecto → ⚙️ Project Settings → API
SUPABASE_URL=https://kktinamqdrkzjyzxpctf.supabase.co

# 🔑 service_role (SECRETA). Permite importar/leer/escribir datos. Solo en local y CI.
SUPABASE_KEY=

# 🔓 anon (PÚBLICA). La usa el panel. Se guarda en config.json (no es secreta, pero cómodo aquí).
SUPABASE_ANON_KEY=

# (Opcional) Personal Access Token: permite crear/actualizar la tabla sin abrir el dashboard.
# Supabase → tu cuenta → Access Tokens → Generate new token.
# Con esto, `node tools/supabase-setup.mjs` aplica supabase/schema.sql solo.
SUPABASE_PAT=

# Opcional
# SUPABASE_TABLE=prospectos
